// ===============================
// IA INTELLIGENTE
// ===============================

function updateAI(car, delta) {
    if (paused || gameOver || !gameStarted) return;

    const goalX = field.x + 25;
    const goalY = canvas.height / 2;

    const distanceToBall = Math.hypot(
        ball.x - car.x,
        ball.y - car.y
    );

    const ballMovingTowardGoal =
        ball.vx < -40;

    // -------------------------------
    // 1. DÉFENSE
    // -------------------------------

    let targetX;
    let targetY;

    if (
        ballMovingTowardGoal &&
        ball.x < canvas.width * 0.65
    ) {
        // L'IA se place entre la balle et son but
        targetX = Math.max(
            field.x + 110,
            ball.x + 80
        );

        targetY =
            ball.y * 0.7 +
            goalY * 0.3;
    }

    // -------------------------------
    // 2. ATTAQUE
    // -------------------------------

    else {
        // L'IA vise légèrement derrière la balle
        // pour pouvoir la pousser vers le but bleu
        targetX = ball.x - 35;
        targetY = ball.y;

        // Si elle est loin, elle va directement
        // vers la balle
        if (distanceToBall > 300) {
            targetX = ball.x;
            targetY = ball.y;
        }
    }

    // -------------------------------
    // 3. DIRECTION
    // -------------------------------

    const dx = targetX - car.x;
    const dy = targetY - car.y;

    const targetAngle = Math.atan2(dy, dx);

    let angleDifference =
        targetAngle - car.angle;

    while (angleDifference > Math.PI) {
        angleDifference -= Math.PI * 2;
    }

    while (angleDifference < -Math.PI) {
        angleDifference += Math.PI * 2;
    }

    // Rotation intelligente
    car.angle +=
        Math.sign(angleDifference) *
        Math.min(
            Math.abs(angleDifference),
            4.2 * delta
        );

    // -------------------------------
    // 4. BOOST INTELLIGENT
    // -------------------------------

    const boostNeeded =
        distanceToBall > 250 ||
        (
            ballMovingTowardGoal &&
            car.x < ball.x
        );

    if (
        boostNeeded &&
        car.boost > 15 &&
        Math.abs(angleDifference) < 0.35
    ) {
        car.boosting = true;
        car.boost -= 28 * delta;
    } else {
        car.boosting = false;
    }

    // -------------------------------
    // 5. VA CHERCHER LES BOOSTS
    // -------------------------------

    if (
        car.boost < 25 &&
        distanceToBall > 180
    ) {
        let nearestPad = null;
        let nearestDistance = Infinity;

        extraBoostPads.forEach(pad => {
            if (!pad.active) return;

            const d = Math.hypot(
                pad.x - car.x,
                pad.y - car.y
            );

            if (d < nearestDistance) {
                nearestDistance = d;
                nearestPad = pad;
            }
        });

        if (nearestPad) {
            const boostDX =
                nearestPad.x - car.x;

            const boostDY =
                nearestPad.y - car.y;

            const boostAngle =
                Math.atan2(boostDY, boostDX);

            let boostDifference =
                boostAngle - car.angle;

            while (boostDifference > Math.PI) {
                boostDifference -= Math.PI * 2;
            }

            while (boostDifference < -Math.PI) {
                boostDifference += Math.PI * 2;
            }

            car.angle +=
                Math.sign(boostDifference) *
                Math.min(
                    Math.abs(boostDifference),
                    4.2 * delta
                );

            if (
                Math.abs(boostDifference) < 0.35
            ) {
                car.boosting = true;
            }

            targetX = nearestPad.x;
            targetY = nearestPad.y;
        }
    }

    // -------------------------------
    // 6. AVANCE
    // -------------------------------

    const currentSpeed =
        car.boosting ? 360 : 230;

    car.vx =
        Math.cos(car.angle) *
        currentSpeed;

    car.vy =
        Math.sin(car.angle) *
        currentSpeed;

    car.x += car.vx * delta;
    car.y += car.vy * delta;

    // Limites du terrain
    car.x = Math.max(
        field.x + car.r,
        Math.min(
            field.x + field.w - car.r,
            car.x
        )
    );

    car.y = Math.max(
        field.y + car.r,
        Math.min(
            field.y + field.h - car.r,
            car.y
        )
    );
}


// ===============================
// ZONE D'ARRÊT AGRANDIE
// DEVANT LE BUT, PAS DANS LE BUT
// ===============================

function checkSaveZone(car, team) {

    const goalCenterY =
        canvas.height / 2;

    let zoneX;

    if (team === "blue") {

        // Zone devant le but bleu
        zoneX = field.x + 125;

    } else {

        // Zone devant le but orange
        zoneX =
            field.x +
            field.w -
            125;
    }

    const zoneWidth = 150;
    const zoneHeight = 220;

    const insideZone =
        car.x >
        zoneX - zoneWidth / 2 &&
        car.x <
        zoneX + zoneWidth / 2 &&
        car.y >
        goalCenterY - zoneHeight / 2 &&
        car.y <
        goalCenterY + zoneHeight / 2;

    // La zone est volontairement devant le but
    // et ne rentre pas dans la cage.

    if (
        insideZone &&
        Math.hypot(ball.vx, ball.vy) > 100
    ) {

        const ballDistance =
            Math.hypot(
                ball.x - car.x,
                ball.y - car.y
            );

        // La voiture doit réellement être proche
        // de la trajectoire de la balle.
        if (ballDistance < 85) {

            if (!car.saveCooldown) {

                car.saveCooldown = true;

                if (team === "blue") {
                    bluePoints += 50;
                    showPoints(
                        "+50 SAVE",
                        "#168cff"
                    );
                } else {
                    orangePoints += 50;
                    showPoints(
                        "+50 SAVE",
                        "#ff6b18"
                    );
                }

                // Repousse la balle
                const dx =
                    ball.x - car.x;

                const dy =
                    ball.y - car.y;

                const length =
                    Math.hypot(dx, dy) || 1;

                ball.vx =
                    (dx / length) * 420;

                ball.vy =
                    (dy / length) * 420;

                setTimeout(() => {
                    car.saveCooldown = false;
                }, 1200);
            }
        }
    }
}
