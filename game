const keys = {};

function getControlKey(event) {
  const key = event.key.toLowerCase();

  if (["z", "q", "s", "d", "p"].includes(key)) {
    return key;
  }

  if (event.code === "Space") {
    return "space";
  }

  return null;
}

document.addEventListener("keydown", e => {
  const controlKey = getControlKey(e);

  if (e.code === "Space") {
    e.preventDefault();
  }

  if (!gameRunning || goalActive) {
    return;
  }

  if (controlKey === "p" && !goalActive) {
    paused = !paused;
    pauseMenu.classList.toggle("hidden", !paused);
    return;
  }

  if (controlKey) {
    keys[controlKey] = true;
  }
});

document.addEventListener("keyup", e => {
  const controlKey = getControlKey(e);

  if (controlKey) {
    keys[controlKey] = false;
  }
});

window.addEventListener("blur", () => {
  clearKeys();
});

function clearKeys() {
  Object.keys(keys).forEach(key => {
    keys[key] = false;
  });
}

function updatePointsDisplay() {
  playerPointsEl.textContent = playerPoints;
}

function showPointsNotification(text) {
  clearTimeout(pointsNotificationTimeout);
  pointsNotification.textContent = text;
  pointsNotification.classList.remove("show");
  void pointsNotification.offsetWidth;
  pointsNotification.classList.add("show");

  pointsNotificationTimeout = setTimeout(() => {
    pointsNotification.classList.remove("show");
    pointsNotificationTimeout = null;
  }, 1200);
}

function awardPoints(amount, reason) {
  playerPoints += amount;
  updatePointsDisplay();
  pointsPanel.classList.remove("earned");
  void pointsPanel.offsetWidth;
  pointsPanel.classList.add("earned");
  showPointsNotification(`+${amount} ${reason}`);
}

function resetPointState() {
  playerPoints = 0;
  saveCooldown = 0;
  saveAwardedForDanger = false;
  updatePointsDisplay();
  pointsPanel.classList.remove("earned");
  clearTimeout(pointsNotificationTimeout);
  pointsNotification.classList.remove("show");
  pointsNotification.textContent = "";
}

/* =========================
   CAR CLASS
========================= */

class Car {

  constructor(x, y, color, isBot = false) {

    this.x = x;
    this.y = y;

    this.startX = x;
    this.startY = y;

    this.color = color;
    this.isBot = isBot;

    this.angle = isBot ? Math.PI : 0;

    this.speed = 0;

    this.radius = 25;

    this.acceleration = 0.18;
    this.reverseAcceleration = 0.12;

    this.maxSpeed = 7.2;
    this.maxReverse = -3.2;

    this.turnSpeed = 0.055;

    this.boost = 100;

    this.boosting = false;
    this.ballContact = false;
  }

  reset() {

    this.x = this.startX;
    this.y = this.startY;

    this.speed = 0;

    this.angle = this.isBot ? Math.PI : 0;

    this.boost = 100;
    this.ballContact = false;
  }

  update() {

    if (this.isBot) {
      this.updateBot();
    } else {
      this.updatePlayer();
    }

    this.x += Math.cos(this.angle) * this.speed;
    this.y += Math.sin(this.angle) * this.speed;

    this.speed *= 0.985;

    if (Math.abs(this.speed) < 0.02) {
      this.speed = 0;
    }

    this.keepInsideField();

    this.boost = Math.min(100, this.boost + 0.025);
  }

  updatePlayer() {

    this.boosting = false;

    // Z = forward
    if (keys["z"]) {
      this.speed += this.acceleration;
    }

    // S = reverse / brake
    if (keys["s"]) {

      if (this.speed > 0) {
        this.speed -= 0.25;
      } else {
        this.speed -= this.reverseAcceleration;
      }

    }

    // Q = left
    if (keys["q"]) {

      const direction = this.speed >= 0 ? 1 : -1;

      this.angle -= this.turnSpeed *
        Math.min(Math.abs(this.speed) / 2 + 0.3, 1) *
        direction;
    }

    // D = right
    if (keys["d"]) {

      const direction = this.speed >= 0 ? 1 : -1;

      this.angle += this.turnSpeed *
        Math.min(Math.abs(this.speed) / 2 + 0.3, 1) *
        direction;
    }

    // SPACE = boost
    if (keys.space && this.boost > 0 && this.speed > 0) {

      this.speed += 0.28;

      this.boost -= 0.7;

      this.boosting = true;
    }

    this.speed = Math.max(
      this.maxReverse,
      Math.min(this.speed, this.maxSpeed)
    );
  }

  updateBot() {

    const distanceToBall = Math.hypot(ball.x - this.x, ball.y - this.y);
    const ballNearOwnGoal = ball.x > W * 0.56;
    const ballNearBlueGoal = ball.x < W * 0.42;
    const shouldDefend = !ballNearOwnGoal &&
      !ballNearBlueGoal &&
      distanceToBall > 250;

    let targetX = ball.x;
    let targetY = ball.y;

    if (shouldDefend) {
      targetX = field.right - 175;
      targetY = H / 2 + (ball.y - H / 2) * 0.5;
    }

    const dx = targetX - this.x;
    const dy = targetY - this.y;

    const targetAngle = Math.atan2(dy, dx);

    let angleDifference =
      ((targetAngle - this.angle + Math.PI * 3) %
        (Math.PI * 2)) - Math.PI;

    if (angleDifference > 0.05) {
      this.angle += this.turnSpeed * 0.95;
    }

    if (angleDifference < -0.05) {
      this.angle -= this.turnSpeed * 0.95;
    }

    this.speed += ballNearOwnGoal || ballNearBlueGoal ? 0.17 : 0.14;

    this.speed = Math.min(this.speed, 6.2);
  }

  keepInsideField() {

    const r = this.radius;

    if (this.x < field.left + r) {
      this.x = field.left + r;
      this.speed *= -0.3;
    }

    if (this.x > field.right - r) {
      this.x = field.right - r;
      this.speed *= -0.3;
    }

    if (this.y < field.top + r) {
      this.y = field.top + r;
      this.speed *= -0.3;
    }

    if (this.y > field.bottom - r) {
      this.y = field.bottom - r;
      this.speed *= -0.3;
    }
  }

  draw() {

    ctx.save();

    ctx.translate(this.x, this.y);
    ctx.rotate(this.angle);

    // Boost trail
    if (this.boosting) {

      ctx.fillStyle = "rgba(80,220,255,0.7)";

      ctx.beginPath();

      ctx.moveTo(-38, -12);
      ctx.lineTo(-65 - Math.random() * 20, 0);
      ctx.lineTo(-38, 12);

      ctx.fill();
    }

    // Car shadow
    ctx.shadowColor = this.color;
    ctx.shadowBlur = 20;

    // Main body
    ctx.fillStyle = this.color;

    roundRect(ctx, -28, -17, 56, 34, 10);
    ctx.fill();

    // Dark roof
    ctx.fillStyle = "#08101a";

    roundRect(ctx, -5, -12, 24, 24, 7);
    ctx.fill();

    // Front light
    ctx.fillStyle = "#ffffff";

    ctx.fillRect(20, -9, 5, 7);
    ctx.fillRect(20, 2, 5, 7);

    // Wheels
    ctx.fillStyle = "#05070b";

    ctx.fillRect(-18, -22, 12, 7);
    ctx.fillRect(8, -22, 12, 7);

    ctx.fillRect(-18, 15, 12, 7);
    ctx.fillRect(8, 15, 12, 7);

    ctx.restore();
  }

}

/* =========================
   BALL CLASS
========================= */

class Ball {

  constructor() {

    this.radius = 18;

    this.reset();
  }

  reset() {

    this.x = W / 2;
    this.y = H / 2;

    this.vx = 0;
    this.vy = 0;
  }

  update() {

    this.x += this.vx;
    this.y += this.vy;

    // Strong damping
    this.vx *= 0.992;
    this.vy *= 0.992;

    // Stop tiny movement
    if (Math.abs(this.vx) < 0.01) this.vx = 0;
    if (Math.abs(this.vy) < 0.01) this.vy = 0;

    // MAX BALL SPEED
    const speed = Math.hypot(this.vx, this.vy);

    const maxBallSpeed = 9;

    if (speed > maxBallSpeed) {

      this.vx = this.vx / speed * maxBallSpeed;
      this.vy = this.vy / speed * maxBallSpeed;
    }

    this.checkGoal();

    if (!goalActive) {
      this.wallCollision();
    }
  }

  checkGoal() {

    /*
    INVISIBLE GOAL DETECTION
    */

    // Ball in blue goal = Orange scores
    if (
      this.x - this.radius <= field.left &&
      this.y > goal.openingTop &&
      this.y < goal.openingBottom
    ) {

      scoreGoal("orange");
    }

    // Ball in orange goal = Blue scores
    if (
      this.x + this.radius >= field.right &&
      this.y > goal.openingTop &&
      this.y < goal.openingBottom
    ) {

      scoreGoal("blue");
    }
  }

  wallCollision() {

    // TOP
    if (this.y - this.radius < field.top) {

      this.y = field.top + this.radius;
      this.vy *= -0.8;
    }

    // BOTTOM
    if (this.y + this.radius > field.bottom) {

      this.y = field.bottom - this.radius;
      this.vy *= -0.8;
    }

    const insideGoalOpening =
      this.y > goal.openingTop &&
      this.y < goal.openingBottom;

    // LEFT WALL
    if (
      this.x - this.radius < field.left &&
      !insideGoalOpening
    ) {

      this.x = field.left + this.radius;
      this.vx *= -0.8;
    }

    // RIGHT WALL
    if (
      this.x + this.radius > field.right &&
      !insideGoalOpening
    ) {

      this.x = field.right - this.radius;
      this.vx *= -0.8;
    }

    // Back walls inside goal

    if (
      this.x < field.left - goal.depth + this.radius &&
      insideGoalOpening
    ) {

      this.x = field.left - goal.depth + this.radius;
      this.vx *= -0.7;
    }

    if (
      this.x > field.right + goal.depth - this.radius &&
      insideGoalOpening
    ) {

      this.x = field.right + goal.depth - this.radius;
      this.vx *= -0.7;
    }
  }

  draw() {

    ctx.save();

    // Shadow
    ctx.fillStyle = "rgba(0,0,0,0.35)";

    ctx.beginPath();
    ctx.ellipse(
      this.x + 6,
      this.y + 8,
      this.radius,
      this.radius * 0.45,
      0,
      0,
      Math.PI * 2
    );

    ctx.fill();

    // Glow
    ctx.shadowColor = "#ffffff";
    ctx.shadowBlur = 20;

    // Ball
    const gradient = ctx.createRadialGradient(
      this.x - 5,
      this.y - 5,
      2,
      this.x,
      this.y,
      this.radius
    );

    gradient.addColorStop(0, "#ffffff");
    gradient.addColorStop(0.5, "#dce7f0");
    gradient.addColorStop(1, "#7d91a3");

    ctx.fillStyle = gradient;

    ctx.beginPath();
    ctx.arc(
      this.x,
      this.y,
      this.radius,
      0,
      Math.PI * 2
    );

    ctx.fill();

    ctx.restore();
  }

}

